;align=center;verticalAlign=middle;fontSize=19;" vertex="1" parent="c2"><mxGeometry x="121.52" y="66.1212" width="43.4" height="46.4635" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=0;fillColor=#122846;strokeColor=#A0A2A6;" vertex="1" parent="c2"><mxGeometry x="164.92" y="16.0835" width="69.44" height="75.0565" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=0;fillColor=#18181A;strokeColor=#6E7074;" vertex="1" parent="c2"><mxGeometry x="327.798" y="78.6306" width="21.4447" height="21.4447" as="geometry"/></mxCell><mxCell id="c44" value="" style="ellipse;fillColor=#3C465A;strokeColor=#96A0B4;" vertex="1" parent="c2"><mxGeometry x="331.658" y="82.4906" width="13.7246" height="13.7246" as="geometry"/></mxCell><mxCell id="c45" value="" style="ellipse;fillColor=#141828;strokeColor=none;" vertex="1" parent="c2"><mxGeometry x="335.947" y="86.7796" width="5.14673" height="5.14673" as="geometry"/></mxCell><mxCell id="c46" value="IMU" style="rounded=0;fillColor=#28292E;strokeColor=#5A5C60;html=1;whiteSpace=wrap;fontColor=#BEC0C6;fontFamily=Consolas;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="247.38" y="130.455" width="26.04" height="25.0188" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=0;fillColor=#60646E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="460" width="85.098" height="2" as="geometry"/></mxCell><mxCell id="c48" value="10 mm   (51 x 21 mm)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="127.098" y="448" width="200" height="24" as="geometry"/></mxCell><mxCell id="c49" value="&lt;font style=&quot;font-size: 30px&quot;&gt;&lt;b&gt;Arducam Pico4ML-BLE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#60646E&quot;&gt;Arducam&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin: 0 0 0 18px; padding: 0&quot;&gt;&lt;li&gt;RP2040 (dual Arm Cortex-M0+, 133 MHz, no FPU), 264 KB SRAM, 2 MB flash&lt;/li&gt;&lt;li&gt;HM01B0 camera, 0.96&quot; ST7735 screen, ICM-42602 IMU, PDM microphone&lt;/li&gt;&lt;li&gt;Flash: UF2 copy onto the RPI-RP2 drive (BOOTSEL, or 1200-baud touch)&lt;/li&gt;&lt;li&gt;Console: USB CDC ACM (Zephyr's own USB stack)&lt;/li&gt;&lt;li&gt;This repo: TinyDigitNet reading hand-written digits from the camera&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="650" height="400" as="geometry"/></mxCell><mxCell id="c50" value="Silhouette drawn to scale from the board's dimensions; not a photo. Edit this file in draw.io." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="650" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>